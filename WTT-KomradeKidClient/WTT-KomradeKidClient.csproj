	<Target Name="GeneratePluginConstants" BeforeTargets="CoreCompile">
		<ItemGroup>
			<WttPluginSource Include="namespace WTTClientCommonLib" />
			<WttPluginSource Include="{" />
			<WttPluginSource Include="internal static class PluginConstants" />
			<WttPluginSource Include="{" />
			<WttPluginSource Include="    public const string Guid = &quot;$(PluginGuid)&quot;%3B" />
			<WttPluginSource Include="    public const string Name = &quot;$(PluginName)&quot;%3B" />
			<WttPluginSource Include="    public const string Version = &quot;$(Version)&quot;%3B" />
			<WttPluginSource Include="}" />
			<WttPluginSource Include="}" />
		</ItemGroup>

		<WriteLinesToFile File="$(IntermediateOutputPath)PluginConstants.g.cs" Lines="@(WttPluginSource)" Overwrite="true" />

		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)PluginConstants.g.cs" />
		</ItemGroup>
	</Target>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants);CHEATMODE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
