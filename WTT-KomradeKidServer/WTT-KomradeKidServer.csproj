<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>KomradeKidServer</RootNamespace>
    <OutputType>Library</OutputType>
	<ModName>WTT-KomradeKidServer</ModName>
	<ModGuid>com.wtt.komradekid</ModGuid>
	<Version>2.1.0</Version>
	<ModAuthor>GrooveypenguinX</ModAuthor>
	<SptushonkaVersion>4.1.5</SptushonkaVersion>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<PackageId>$(ModName)</PackageId>
	<AssemblyName>$(ModName)</AssemblyName>
	<SptVersion>~$(SptushonkaVersion)</SptVersion>
	<Authors>$(ModAuthor)</Authors>
	<License>MIT</License>
	<OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)-$(Version)\</OutputPath>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<Configurations>Debug;Release</Configurations>
	<Platforms>AnyCPU</Platforms>
  </PropertyGroup>

	<Target Name="GenerateModConstants" BeforeTargets="CoreCompile">
		<ItemGroup>
			<ModSource Include="namespace $(RootNamespace);" />
			<ModSource Include="{" />
			<ModSource Include="internal static class ModConstants" />
			<ModSource Include="{" />
			<ModSource Include="    public const string Guid = &quot;$(ModGuid)&quot;%3B" />
			<ModSource Include="    public const string Name = &quot;$(ModName)&quot;%3B" />
			<ModSource Include="    public const string Author = &quot;$(ModAuthor)&quot;%3B" />
			<ModSource Include="    public const string Version = &quot;$(Version)&quot;%3B" />
			<ModSource Include="    public const string SptVersion = &quot;$(SptVersion)&quot;%3B" />
			<ModSource Include="    public const string License = &quot;$(License)&quot;%3B" />
			<ModSource Include="}" />
			<ModSource Include="}" />
		</ItemGroup>

		<WriteLinesToFile File="$(IntermediateOutputPath)ModConstants.g.cs" Lines="@(ModSource)" Overwrite="true" />

		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)ModConstants.g.cs" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="SPTushonka.Common" Version="$(SptushonkaVersion)" />
		<PackageReference Include="SPTushonka.DI" Version="$(SptushonkaVersion)" />
		<PackageReference Include="SPTushonka.Reflection" Version="$(SptushonkaVersion)" />
		<PackageReference Include="SPTushonka.Server.Core" Version="$(SptushonkaVersion)" />
    <PackageReference Include="WTT-ServerCommonLib" Version="3.0.0" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="@echo off&#xA;setlocal enabledelayedexpansion&#xA;&#xA;REM Set variables&#xA;set MODNAME=$(TargetName)&#xA;set DLLPATH=$(TargetDir)$(TargetName).dll&#xA;set OUTDIR=..\..\..\SPT_Runtime\user\mods\%MODNAME%&#xA;set RESOURCESDIR=$(ProjectDir)Resources&#xA;set BUILDOUTDIR=..\Build\SPT_Runtime\user\mods\%MODNAME%&#xA;&#xA;REM Create output directories if they don't exist&#xA;if not exist &quot;%OUTDIR%&quot; mkdir &quot;%OUTDIR%&quot;&#xA;if not exist &quot;%BUILDOUTDIR%&quot; mkdir &quot;%BUILDOUTDIR%&quot;&#xA;&#xA;REM Clear the output directory (except the dll we're about to copy)&#xA;if exist &quot;%OUTDIR%&quot; (&#xA;    for /d %%D in (&quot;%OUTDIR%\*&quot;) do rmdir /s /q &quot;%%D&quot;&#xA;    for %%F in (&quot;%OUTDIR%\*&quot;) do (&#xA;        if /i not &quot;%%~nxF&quot;==&quot;$(TargetName).dll&quot; del /q &quot;%%F&quot;&#xA;    )&#xA;)&#xA;&#xA;REM Clear the build output directory completely&#xA;if exist &quot;%BUILDOUTDIR%&quot; (&#xA;    for /d %%D in (&quot;%BUILDOUTDIR%\*&quot;) do rmdir /s /q &quot;%%D&quot;&#xA;    for %%F in (&quot;%BUILDOUTDIR%\*&quot;) do del /q &quot;%%F&quot;&#xA;)&#xA;&#xA;REM Copy the DLL file to SPT&#xA;copy /Y &quot;%DLLPATH%&quot; &quot;%OUTDIR%\&quot; &gt;nul 2&gt;&amp;1&#xA;echo [PostBuild] Copied %MODNAME%.dll to %OUTDIR%&#xA;&#xA;REM Copy all contents from Resources folder recursively to SPT&#xA;if exist &quot;%RESOURCESDIR%&quot; (&#xA;    xcopy &quot;%RESOURCESDIR%&quot; &quot;%OUTDIR%&quot; /E /I /Y &gt;nul 2&gt;&amp;1&#xA;    echo [PostBuild] Copied Resources to %OUTDIR%&#xA;) else (&#xA;    echo [PostBuild] Warning: Resources folder not found at %RESOURCESDIR%&#xA;)&#xA;&#xA;REM Copy the DLL file to Build folder&#xA;copy /Y &quot;%DLLPATH%&quot; &quot;%BUILDOUTDIR%\&quot; &gt;nul 2&gt;&amp;1&#xA;echo [PostBuild] Copied %MODNAME%.dll to %BUILDOUTDIR%&#xA;&#xA;REM Copy all contents from Resources folder recursively to Build folder&#xA;if exist &quot;%RESOURCESDIR%&quot; (&#xA;    xcopy &quot;%RESOURCESDIR%&quot; &quot;%BUILDOUTDIR%&quot; /E /I /Y &gt;nul 2&gt;&amp;1&#xA;    echo [PostBuild] Copied Resources to %BUILDOUTDIR%&#xA;) else (&#xA;    echo [PostBuild] Warning: Resources folder not found at %RESOURCESDIR%&#xA;)&#xA;&#xA;echo [PostBuild] Build output: %OUTDIR% and %BUILDOUTDIR%&#xA;endlocal&#xA;" />
  </Target>
</Project>